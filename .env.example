# Database Configuration
PGMATE_DB_HOST=localhost
PGMATE_DB_PORT=5432
PGMATE_DB_NAME=your_database
PGMATE_DB_USER=your_username
PGMATE_DB_PASSWORD=your_password
PGMATE_DB_SCHEMA=public

# LLM Configuration
# Provider: openai or anthropic (default: openai)
PGMATE_LLM_PROVIDER=openai

# OpenAI Configuration (if using openai provider)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Anthropic Configuration (if using anthropic provider)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Memory Storage (optional)
# PGMATE_MEMORY_DIR=~/.pgmate/memory
